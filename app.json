{
  "expo": {
    "name": "Shots",
    "slug": "shots-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shotsapp.staff"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.shotsapp.staff",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shots to access your photos so you can attach a member's profile picture and ID card.",
          "cameraPermission": "Allow Shots to use the camera so you can capture a member's profile picture and ID card."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Shots to use the camera to scan membership QR codes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Shots to access your photos.",
          "savePhotosPermission": "Allow Shots to save membership cards to your photo gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "owner": "zerotyping",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "fa2ddb45-2798-47f6-88ab-215cbded8a1b"
      }
    }
  }
}
