{
  "expo": {
    "name": "Shots",
    "slug": "shots-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shotsapp.staff"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.shotsapp.staff",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Shots to access your photos so you can attach a member's profile picture and ID card.",
          "cameraPermission": "Allow Shots to use the camera so you can capture a member's profile picture and ID card."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a153b3bc-a4d1-46ed-9e5f-2601a96ed874"
      }
    },
    "owner": "abdullahg144"
  }
}
